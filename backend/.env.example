# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
# Production: set FRONTEND_URL to the Vercel domain, e.g.
#   FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated (custom domains, staging, etc.)
CORS_ORIGINS=
# Regex for Vercel preview deployments. Leave blank to disable.
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Temporary Storage
TEMP_DIR=./tmp/ncert
OUTPUT_DIR=./output

# Background jobs.
# MinerU holds several GB of models in RAM per run; raise above 1 only if the
# droplet has headroom for a full extra copy of the pipeline.
MAX_CONCURRENT_EXTRACTIONS=1
# LLM jobs are network-bound, so a few can overlap. This cap exists to stay
# inside DeepSeek rate limits, not to save memory.
MAX_CONCURRENT_LLM_JOBS=4

# MinerU Configuration
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=auto
MINERU_SERVER_URL=
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_IMAGE_ANALYSIS=false
MINERU_CPU_THREADS=0
MINERU_TIMEOUT_SECONDS=3600
MINERU_QUALITY_MODE=max
MINERU_OCR_FALLBACK=true

# Semantic Intelligence LLM
# Which LLM drives semantic intelligence: "deepseek" or "gemini".
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# flash is 3x cheaper than deepseek-v4-pro on every line (input cache-miss
# $0.22 vs $0.66 per 1M off-peak, output $0.66 vs $1.98), and output is ~70% of
# what a chapter costs. Agent 4 writes the CBSE mark schemes and is where a
# smaller model shows first: _assemble_rubrics drops items whose source_evidence
# quotes are not verbatim, so watch the rubric item counts after switching.
DEEPSEEK_MODEL=deepseek-v4-flash

# Only used when LLM_PROVIDER=gemini. Extra keys can be added as
# GEMINI_API_KEY2, GEMINI_API_KEY3, ... and are rotated automatically when one
# hits its rate limit; a key that is revoked is dropped for the rest of the run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Spend guards. DeepSeek v4 models are REASONING models: 60-78% of the output
# tokens they bill are hidden chain-of-thought you never see. One 16-concept
# chapter cost ~765k tokens on deepseek-v4-pro. A run past this ceiling stops
# and keeps whatever it already produced.
SEMANTIC_MAX_TOKENS_PER_CHAPTER=1500000
# TOPICS processed at once; each fires 4 agent calls covering all of that
# topic's concepts. The swarm is billed per CALL, not per word - ~9,000 tokens
# of role prompt and JSON schema ride on every one whatever the slice size - so
# the slice count is what sets a chapter's price. Slicing per leaf concept
# instead of per topic is what took a chapter from ~$0.5 to ~$5.
SEMANTIC_MAX_CONCURRENCY=5
# Most concepts one agent call may be asked for. Agent 4 writes 4-6 full mark
# schemes per concept, so a wide topic would ask for ~50 in a single reply; one
# that overruns is unparseable, retried 3 times, billed 3 times, and returns
# nothing. Topics above this are split into batches over the same slice.
SEMANTIC_MAX_CONCEPTS_PER_CALL=8
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# MariaDB (extractions are saved to document_extractions after each job)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DB=pdf_extraction

MARIADB_HOST=202.47.117.220
MARIADB_PORT=3306
MARIADB_USER=sonika_user
MARIADB_PASSWORD=sonika@sql
MARIADB_DB=sonika_erp

# Phase 3 — Teaching Intelligence
PHASE3_PROMPT_VERSION=1
PHASE3_DEFAULT_STYLE=engaging
