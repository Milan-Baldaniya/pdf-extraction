# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
# Production: set FRONTEND_URL to the Vercel domain, e.g.
#   FRONTEND_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated (custom domains, staging, etc.)
CORS_ORIGINS=
# Regex for Vercel preview deployments. Leave blank to disable.
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Temporary Storage
TEMP_DIR=./tmp/ncert
OUTPUT_DIR=./output

# Background jobs.
# MinerU holds several GB of models in RAM per run; raise above 1 only if the
# droplet has headroom for a full extra copy of the pipeline.
MAX_CONCURRENT_EXTRACTIONS=1
# LLM jobs are network-bound, so a few can overlap. This cap exists to stay
# inside DeepSeek rate limits, not to save memory.
MAX_CONCURRENT_LLM_JOBS=4

# MinerU Configuration
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=auto
MINERU_SERVER_URL=
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_IMAGE_ANALYSIS=false
MINERU_CPU_THREADS=0
MINERU_TIMEOUT_SECONDS=3600
MINERU_QUALITY_MODE=max
MINERU_OCR_FALLBACK=true

# DeepSeek Semantic Intelligence
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# MariaDB (extractions are saved to document_extractions after each job)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DB=pdf_extraction

MARIADB_HOST=202.47.117.220
MARIADB_PORT=3306
MARIADB_USER=sonika_user
MARIADB_PASSWORD=sonika@sql
MARIADB_DB=sonika_erp

# Phase 3 — Teaching Intelligence
PHASE3_PROMPT_VERSION=1
PHASE3_DEFAULT_STYLE=engaging
