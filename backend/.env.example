# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
FRONTEND_URL=http://localhost:3000

# Temporary Storage
TEMP_DIR=./tmp/ncert
OUTPUT_DIR=./output

# MinerU Configuration
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=auto
MINERU_SERVER_URL=
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_IMAGE_ANALYSIS=false
MINERU_CPU_THREADS=0
MINERU_TIMEOUT_SECONDS=3600
MINERU_QUALITY_MODE=max
MINERU_OCR_FALLBACK=true

# Semantic Intelligence LLM
# Which LLM drives semantic intelligence: "deepseek" or "gemini".
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Only used when LLM_PROVIDER=gemini. Extra keys can be added as
# GEMINI_API_KEY2, GEMINI_API_KEY3, ... and are rotated automatically when one
# hits its rate limit; a key that is revoked is dropped for the rest of the run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Spend guards. DeepSeek v4 models are REASONING models: 60-78% of the output
# tokens they bill are hidden chain-of-thought you never see. One 16-concept
# chapter cost ~765k tokens on deepseek-v4-pro. A run past this ceiling stops
# and keeps whatever it already produced.
SEMANTIC_MAX_TOKENS_PER_CHAPTER=1500000
# Concepts processed at once; each fires up to 4 agent calls.
SEMANTIC_MAX_CONCURRENCY=5
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# MariaDB (extractions are saved to document_extractions after each job)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DB=pdf_extraction

MARIADB_HOST=202.47.117.220
MARIADB_PORT=3306
MARIADB_USER=sonika_user
MARIADB_PASSWORD=sonika@sql
MARIADB_DB=sonika_erp

# Phase 3 — Teaching Intelligence
PHASE3_PROMPT_VERSION=1
PHASE3_DEFAULT_STYLE=engaging
