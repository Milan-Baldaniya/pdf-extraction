# Base URL of the FastAPI backend, including the /api prefix.
# Local development:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Production must be HTTPS — a page served from Vercel over HTTPS cannot call
# a plain http:// backend; the browser blocks it as mixed content.
#   NEXT_PUBLIC_API_URL=https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Server-side only (no NEXT_PUBLIC_ prefix), used by /api/gamma routes.
GAMMA_API_KEY=
