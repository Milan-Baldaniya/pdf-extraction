# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
FRONTEND_URL=http://localhost:3000

# Temporary Storage
TEMP_DIR=./tmp/ncert
OUTPUT_DIR=./output

# MinerU Configuration
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=auto
MINERU_SERVER_URL=
MINERU_FORMULA=true
MINERU_TABLE=true
MINERU_IMAGE_ANALYSIS=false
MINERU_CPU_THREADS=0
MINERU_TIMEOUT_SECONDS=3600
MINERU_QUALITY_MODE=max
MINERU_OCR_FALLBACK=true

# Semantic Intelligence
SEMANTIC_INTELLIGENCE_PROMPT_VERSION=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# MariaDB (extractions are saved to document_extractions after each job)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DB=pdf_extraction

